{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "screenpipe",
  "identifier": "screenpi.pe",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "targets": ["app", "dmg", "appimage", "nsis"],
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/screenpipe-logo-tray-failed.png",
      "icons/screenpipe-logo-tray-black.png"
    ],
    "resources": ["assets/*"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QzMxNjYwNTM5OEUwNTgKUldSWTRKaFRZQmJER1h4d1ZMYVA3dnluSjdpN2RmMldJR09hUFFlZDY0SlFqckkvRUJhZDJVZXAK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["screenpipe"]
      },
      "mobile": [
        {
          "host": "screenpi.pe",
          "pathPrefix": ["/auth"]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": ["/stripe-connect"]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": ["/purchase-successful"]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": ["/settings"]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": ["/changelog"]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": ["/onboarding"]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": ["/status"]
        }
      ]
    }
  },
  "app": {
    "trayIcon": {
      "id": "screenpipe_main",
      "iconPath": "icons/screenpipe-logo-tray-black.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "title": "screenpipe",
        "width": 1200,
        "height": 850,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      },
      "csp": null
    },
    "macOSPrivateApi": true
  }
}
